# ==============================================================================
# ENVIRONMENT & RUNTIME
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# DATABASE (PostgreSQL 16)
# ==============================================================================
# Local Docker & Render internal network connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/commitments_db

# ==============================================================================
# REDIS (Cache & Task Broker)
# ==============================================================================
# Local Docker & Render internal Redis URL
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# OBJECT STORAGE (MinIO / S3 Compatible)
# ==============================================================================
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=audio-streamer-records
S3_REGION=us-east-1

# ==============================================================================
# FRONTEND & CORS CONFIGURATION
# ==============================================================================
# Public URL of the FastAPI Backend (used by Next.js in browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Allowed origins for FastAPI CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# ==============================================================================
# AI PROVIDER API KEYS
# ==============================================================================
# STT: Groq Whisper (recommended for sub-second speed) or OpenAI Whisper API
GROQ_API_KEY=
OPENAI_API_KEY=

# Reasoning LLM: Gemini 2.5 Flash / GPT-4o-mini
GEMINI_API_KEY=
